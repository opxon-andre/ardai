# Non-secret configuration. Copy to .env and adapt on the Linux Docker HOST.
ARDAI_WORKSPACE=/srv/ardai
ARDAI_PROJECT_DIR=/srv/ardai/project
ARDAI_UID=1000
ARDAI_GID=1000
# Set to: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
ARDAI_UI_HOST=127.0.0.1
# LAN/VPN access: set ARDAI_UI_HOST=0.0.0.0; startup prints the local access URLs.
ARDAI_UI_PORT=4711
# Explicit HTTP Host authorities for a reverse proxy, e.g. ardai.example.com
ARDAI_UI_ALLOWED_HOSTS=
ARDAI_SECRETS_DIR=./secrets
ARDAI_HOME_DIR=./secrets/home
ARDAI_UI_TOKEN_FILE=/run/secrets/ui_token
# Enable only the credentials you use; values below are FILE PATHS, never keys.
# CODEX_API_KEY_FILE=/run/secrets/codex_api_key
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# CLAUDE_CODE_OAUTH_TOKEN_FILE=/run/secrets/claude_oauth_token
# ARDAI_JIRA_EMAIL_FILE=/run/secrets/jira_email
# ARDAI_JIRA_TOKEN_FILE=/run/secrets/jira_token
# ARDAI_GIT_TOKEN_FILE=/run/secrets/git_token
# ARDAI_GIT_USERNAME=git
# Agent login files can alternatively live in secrets/home (the persistent HOME).
# Configure the Git identity used for task commits:
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com
# Optional reproducible agent builds: replace latest with tested exact versions.
CODEX_VERSION=latest
CLAUDE_CODE_VERSION=latest
